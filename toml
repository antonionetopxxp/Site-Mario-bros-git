# netlify.toml
[build]
  publish = "dist"
  command = "npm run build"

[[redirects]]
  from = "/old-path/*"
  to = "/new-path/:splat"
  status = 301

[[headers]]
  for = "*.js"
  [headers.values]
    Cache-Control = "public, max-age=31536000"
    
[[headers]]
  for = "*.css"
  [headers.values]
    Cache-Control = "public, max-age=31536000"
